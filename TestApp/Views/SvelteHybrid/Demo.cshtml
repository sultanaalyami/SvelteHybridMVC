@{
    ViewData["Title"] = "SvelteHybrid Demo";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="display-4">SvelteHybrid Demo</h1>
        <p class="lead text-muted">Reactive components without page reload - Zero configuration!</p>
    </div>

    <div class="row g-4">
        <!-- Counter -->
        <div class="col-md-6">
            <div class="s-card">
                <div class="s-card-header">Reactive Counter</div>
                <div class="s-card-body" s-reactive s-data="{ count: 0 }">
                    <div class="display-1 text-center mb-3" s-text="count"></div>
                    <div class="s-flex s-gap-2 s-justify-center">
                        <button class="s-btn s-btn-primary" s-click="count++">+ Add</button>
                        <button class="s-btn s-btn-outline" s-click="count--">- Subtract</button>
                        <button class="s-btn s-btn-danger" s-click="count = 0">Reset</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Two-way Binding -->
        <div class="col-md-6">
            <div class="s-card">
                <div class="s-card-header">Two-Way Binding</div>
                <div class="s-card-body" s-reactive s-data="{ name: '', message: '' }">
                    <div class="mb-3">
                        <label class="form-label">Your Name</label>
                        <input type="text" class="s-input" s-model="name" placeholder="Type your name...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea class="s-input" s-model="message" rows="2" placeholder="Write something..."></textarea>
                    </div>
                    <div class="alert alert-info" s-show="name || message">
                        <strong>Hello, <span s-text="name"></span>!</strong>
                        <p class="mb-0 mt-1" s-text="message"></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Conditional Tabs -->
        <div class="col-md-6">
            <div class="s-card">
                <div class="s-card-header">Conditional Rendering</div>
                <div class="s-card-body" s-reactive s-data="{ activeTab: 'home' }">
                    <div class="s-flex s-gap-2 s-mb-4">
                        <button class="s-btn" 
                                s-class="{ 's-btn-primary': activeTab === 'home', 's-btn-outline': activeTab !== 'home' }"
                                s-click="activeTab = 'home'">Home</button>
                        <button class="s-btn"
                                s-class="{ 's-btn-primary': activeTab === 'profile', 's-btn-outline': activeTab !== 'profile' }"
                                s-click="activeTab = 'profile'">Profile</button>
                        <button class="s-btn"
                                s-class="{ 's-btn-primary': activeTab === 'settings', 's-btn-outline': activeTab !== 'settings' }"
                                s-click="activeTab = 'settings'">Settings</button>
                    </div>
                    
                    <div class="p-3 bg-light rounded" s-if="activeTab === 'home'">
                        <h5>Welcome Home!</h5>
                        <p class="mb-0">This is the home tab content.</p>
                    </div>
                    <div class="p-3 bg-light rounded" s-if="activeTab === 'profile'">
                        <h5>Your Profile</h5>
                        <p class="mb-0">Manage your profile settings here.</p>
                    </div>
                    <div class="p-3 bg-light rounded" s-if="activeTab === 'settings'">
                        <h5>Settings</h5>
                        <p class="mb-0">Configure your preferences.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Toast Notifications -->
        <div class="col-md-6">
            <div class="s-card">
                <div class="s-card-header">Toast Notifications</div>
                <div class="s-card-body">
                    <p class="mb-3">Click buttons to show toast notifications:</p>
                    <div class="s-flex s-gap-2 flex-wrap">
                        <button class="s-btn s-btn-success" onclick="SvelteHybrid.toast('Operation completed!', 'success')">Success</button>
                        <button class="s-btn s-btn-danger" onclick="SvelteHybrid.toast('Something went wrong!', 'error')">Error</button>
                        <button class="s-btn" style="background:#f59e0b;color:white" onclick="SvelteHybrid.toast('Be careful!', 'warning')">Warning</button>
                        <button class="s-btn" style="background:#3b82f6;color:white" onclick="SvelteHybrid.toast('Information here', 'info')">Info</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading States -->
        <div class="col-md-6">
            <div class="s-card">
                <div class="s-card-header">Loading States</div>
                <div class="s-card-body" s-reactive s-data="{ loading: false, result: '' }">
                    <button class="s-btn s-btn-primary" 
                            s-click="loading = true; result = ''; setTimeout(function() { result = 'Data loaded at ' + new Date().toLocaleTimeString(); loading = false; }, 2000)"
                            s-disabled="loading">
                        <span class="s-loading s-loading-sm" s-show="loading"></span>
                        <span s-if="loading">Loading...</span>
                        <span s-if="!loading">Fetch Data</span>
                    </button>
                    
                    <div class="alert alert-success mt-3" s-show="result">
                        <span s-text="result"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Example -->
        <div class="col-md-6">
            <div class="s-card">
                <div class="s-card-header">Modal Dialog</div>
                <div class="s-card-body">
                    <button class="s-btn s-btn-primary" onclick="document.getElementById('demo-modal').classList.add('s-modal-open')">
                        Open Modal
                    </button>
                </div>
            </div>
        </div>

        <!-- Form Example -->
        <div class="col-md-6">
            <div class="s-card">
                <div class="s-card-header">Form Handling</div>
                <div class="s-card-body" s-reactive s-data="{ submitted: false, userName: '', userEmail: '' }">
                    <div class="mb-3" s-if="!submitted">
                        <input type="text" class="s-input mb-2" s-model="userName" placeholder="Your name">
                        <input type="email" class="s-input mb-2" s-model="userEmail" placeholder="Your email">
                        <button class="s-btn s-btn-primary" s-click="submitted = true" s-disabled="!userName || !userEmail">Submit</button>
                    </div>
                    
                    <div class="alert alert-success" s-if="submitted">
                        <strong>Submitted!</strong><br>
                        Name: <span s-text="userName"></span><br>
                        Email: <span s-text="userEmail"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dynamic List -->
        <div class="col-12">
            <div class="s-card">
                <div class="s-card-header">Dynamic List</div>
                <div class="s-card-body" s-reactive s-data="{ items: ['Item 1', 'Item 2', 'Item 3'], newItem: '' }">
                    <div class="s-flex s-gap-2 s-mb-4">
                        <input type="text" class="s-input" s-model="newItem" placeholder="Add new item...">
                        <button class="s-btn s-btn-success" 
                                s-click="if(newItem.trim()) { items.push(newItem); newItem = ''; }"
                                s-disabled="!newItem.trim()">Add</button>
                    </div>
                    <ul class="list-group" id="items-list"></ul>
                    <p class="text-muted mt-2">Total items: <span s-text="items.length"></span></p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div id="demo-modal" s-modal="demo-modal" class="s-modal">
    <div class="s-modal-content">
        <h4>Modal Dialog</h4>
        <p>This is a modal dialog. Click outside or the button below to close.</p>
        <div class="s-flex s-justify-between s-mt-4">
            <button class="s-btn s-btn-outline" onclick="document.getElementById('demo-modal').classList.remove('s-modal-open')">Cancel</button>
            <button class="s-btn s-btn-primary" onclick="SvelteHybrid.toast('Confirmed!', 'success'); document.getElementById('demo-modal').classList.remove('s-modal-open')">Confirm</button>
        </div>
    </div>
</div>

<style>
    .s-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.5);
        z-index: 9999;
        justify-content: center;
        align-items: center;
    }
    .s-modal.s-modal-open {
        display: flex;
    }
    .s-modal-content {
        background: white;
        padding: 24px;
        border-radius: 8px;
        max-width: 500px;
        width: 90%;
    }
</style>
