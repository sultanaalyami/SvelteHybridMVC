<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="نظام هجين يجمع بين ASP.NET MVC و Svelte" />
    <title>@ViewData["Title"] - SvelteHybridMVC</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar">
            <a asp-controller="Home" asp-action="Index">🏠 الرئيسية</a>
            <a asp-controller="Products" asp-action="Index">📦 المنتجات</a>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <p>&copy; @DateTime.Now.Year - <strong>SvelteHybridMVC</strong> | نظام هجين ASP.NET + Svelte</p>
    </footer>

    <script src="~/_svelte/client.js" type="module" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
