@{
    ViewData["Title"] = "الرئيسية";
}

<div class="welcome-section">
    <h1>مرحباً بك في HRCE</h1>
    <p>نظام هجين يجمع بين قوة ASP.NET MVC وتفاعلية SvelteKit</p>
    
    <div class="features">
        <div class="feature">
            <h3>🎯 MVC مهيمن</h3>
            <p>تحكم كامل من Razor مع مكونات Svelte تفاعلية</p>
        </div>
        <div class="feature">
            <h3>⚡ SSR سريع</h3>
            <p>عرض على الخادم مع Hydration انتقائي</p>
        </div>
        <div class="feature">
            <h3>🔄 تحديث حي</h3>
            <p>Hot Reload لكل من C# و Svelte</p>
        </div>
        <div class="feature" style="background: linear-gradient(135deg, rgba(100,150,255,0.1) 0%, rgba(150,100,255,0.1) 100%); border: 2px solid rgba(100,150,255,0.3);">
            <h3>🧠 تصور نخاعي حي</h3>
            <p>تصور بيانات eBPF كنخاع شوكي رقمي نابض بالحياة</p>
            <a asp-controller="Visualization" asp-action="QuantumMultiverse" class="btn btn-primary" style="margin-top: 10px; background: linear-gradient(135deg, #6495ED 0%, #9370DB 100%);">
                شاهد التصور المبهر ✨
            </a>
        </div>
    </div>
    
    <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
        استعرض المنتجات
    </a>
</div>
