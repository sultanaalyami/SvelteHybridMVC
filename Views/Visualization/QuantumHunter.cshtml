@{
    ViewData["Title"] = "Quantum Hunter - صائد الكم";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            overflow: hidden;
            background: #000008;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
        }

        /* Canvas container - behind everything */
        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        #canvas-container canvas {
            display: block;
        }

        /* ============ UI Layer - Above Canvas ============ */
        .ui-layer {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            pointer-events: none;
        }

        .ui-layer > * {
            pointer-events: auto;
        }

        /* ============ شريط الأدوات العلوي ============ */
        .top-toolbar {
            position: absolute;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 15px;
            background: rgba(0, 20, 40, 0.95);
            padding: 12px 25px;
            border-radius: 50px;
            border: 2px solid rgba(0, 200, 255, 0.4);
            box-shadow: 0 0 30px rgba(0, 200, 255, 0.2);
        }

        .tool-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: 2px solid rgba(0, 200, 255, 0.5);
            background: rgba(0, 50, 100, 0.6);
            color: #0cf;
            font-size: 22px;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .tool-btn:hover {
            background: rgba(0, 200, 255, 0.4);
            transform: scale(1.15);
            box-shadow: 0 0 25px rgba(0, 200, 255, 0.6);
        }

        .tool-btn.active {
            background: rgba(0, 255, 200, 0.5);
            border-color: #0fa;
            color: #0fa;
            box-shadow: 0 0 30px rgba(0, 255, 200, 0.6);
        }

        .tool-btn.slowmo-active {
            background: rgba(255, 100, 0, 0.5);
            border-color: #f80;
            color: #fff;
            animation: slowmoPulse 0.5s infinite;
        }

        @@keyframes slowmoPulse {
            0%, 100% { box-shadow: 0 0 20px rgba(255, 100, 0, 0.5); }
            50% { box-shadow: 0 0 50px rgba(255, 100, 0, 1); }
        }

        .tool-tip {
            position: absolute;
            bottom: -30px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 10px;
            white-space: nowrap;
            background: rgba(0, 0, 0, 0.8);
            padding: 4px 8px;
            border-radius: 4px;
            opacity: 0;
            transition: opacity 0.2s;
            pointer-events: none;
        }

        .tool-btn:hover .tool-tip {
            opacity: 1;
        }

        /* ============ لوحة المعلومات ============ */
        .info-panel {
            position: absolute;
            top: 100px;
            right: 20px;
            width: 280px;
            background: rgba(0, 20, 40, 0.95);
            border: 2px solid rgba(0, 200, 255, 0.3);
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 0 30px rgba(0, 200, 255, 0.15);
        }

        .panel-title {
            font-size: 14px;
            color: #0cf;
            text-align: center;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(0, 200, 255, 0.3);
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
            font-size: 13px;
        }

        .stat-label { color: rgba(255,255,255,0.6); }
        .stat-value { color: #0fa; font-family: monospace; font-weight: bold; }

        /* ============ لوحة التحكم ============ */
        .control-panel {
            position: absolute;
            top: 100px;
            left: 20px;
            width: 260px;
            background: rgba(0, 20, 40, 0.95);
            border: 2px solid rgba(0, 200, 255, 0.3);
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 0 30px rgba(0, 200, 255, 0.15);
        }

        .control-btn {
            width: 100%;
            padding: 12px;
            margin: 6px 0;
            border-radius: 8px;
            border: 1px solid rgba(0, 200, 255, 0.4);
            background: rgba(0, 50, 100, 0.4);
            color: #0cf;
            font-size: 13px;
            cursor: pointer;
            transition: all 0.3s;
            text-align: right;
        }

        .control-btn:hover {
            background: rgba(0, 200, 255, 0.3);
            border-color: rgba(0, 200, 255, 0.7);
            transform: translateX(-5px);
        }

        .control-btn.danger {
            border-color: rgba(255, 100, 100, 0.5);
            color: #f88;
        }

        .control-btn.danger:hover {
            background: rgba(255, 100, 100, 0.3);
        }

        /* ============ شريط سرعة الضوء ============ */
        .lightspeed-bar {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            width: 400px;
            background: rgba(0, 20, 40, 0.95);
            padding: 15px 25px;
            border-radius: 25px;
            border: 2px solid rgba(0, 200, 255, 0.3);
        }

        .lightspeed-label {
            text-align: center;
            font-size: 12px;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 10px;
        }

        .lightspeed-slider {
            width: 100%;
            height: 8px;
            border-radius: 4px;
            background: rgba(0, 50, 100, 0.5);
            -webkit-appearance: none;
            outline: none;
        }

        .lightspeed-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0ff, #08f);
            cursor: pointer;
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.6);
        }

        .speed-labels {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            font-size: 10px;
            color: rgba(255, 255, 255, 0.5);
        }

        /* ============ نافذة الهولوجرام ============ */
        .hologram-window {
            position: absolute;
            display: none;
            width: 380px;
            background: rgba(0, 30, 60, 0.98);
            border: 2px solid rgba(0, 255, 255, 0.7);
            border-radius: 20px;
            padding: 20px;
            box-shadow: 
                0 0 60px rgba(0, 255, 255, 0.4),
                inset 0 0 40px rgba(0, 255, 255, 0.1);
        }

        .hologram-window.visible {
            display: block;
            animation: holoAppear 0.3s ease-out;
        }

        @@keyframes holoAppear {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
        }

        .holo-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid rgba(0, 255, 255, 0.3);
        }

        .holo-title {
            font-size: 15px;
            color: #0ff;
            text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
        }

        .holo-close {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 1px solid rgba(255, 100, 100, 0.5);
            background: rgba(255, 50, 50, 0.2);
            color: #f88;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }

        .holo-close:hover {
            background: rgba(255, 50, 50, 0.4);
        }

        .holo-content {
            max-height: 280px;
            overflow-y: auto;
        }

        .holo-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(0, 255, 255, 0.1);
            font-size: 12px;
        }

        .holo-key { color: rgba(255,255,255,0.5); }
        .holo-value { 
            color: #0fa; 
            font-family: monospace;
            max-width: 180px;
            text-overflow: ellipsis;
            overflow: hidden;
        }

        .holo-actions {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid rgba(0, 255, 255, 0.3);
        }

        .holo-btn {
            flex: 1;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid;
            background: transparent;
            cursor: pointer;
            font-size: 11px;
            transition: all 0.2s;
        }

        .holo-btn.track { border-color: #0af; color: #0af; }
        .holo-btn.suspend { border-color: #fa0; color: #fa0; }
        .holo-btn.kill { border-color: #f44; color: #f44; }

        .holo-btn:hover { background: rgba(255, 255, 255, 0.1); }

        /* ============ مؤشر التتبع ============ */
        .tracker {
            position: absolute;
            width: 60px;
            height: 60px;
            border: 2px solid #0ff;
            border-radius: 50%;
            display: none;
            pointer-events: none;
            animation: trackerPulse 1s infinite;
        }

        .tracker.active { display: block; }

        .tracker::before, .tracker::after {
            content: '';
            position: absolute;
            background: #0ff;
        }

        .tracker::before {
            width: 2px; height: 20px;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
        }

        .tracker::after {
            width: 20px; height: 2px;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
        }

        @@keyframes trackerPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.2); opacity: 0.7; }
        }

        /* ============ تحدي البحث ============ */
        .challenge-box {
            position: absolute;
            bottom: 100px;
            right: 20px;
            width: 280px;
            background: rgba(50, 20, 0, 0.95);
            border: 2px solid rgba(255, 150, 0, 0.6);
            border-radius: 15px;
            padding: 20px;
            display: none;
        }

        .challenge-box.active { display: block; }

        .challenge-title {
            color: #fa0;
            font-size: 14px;
            text-align: center;
            margin-bottom: 15px;
        }

        .challenge-target {
            background: rgba(0, 0, 0, 0.4);
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 15px;
            font-size: 12px;
        }

        .challenge-timer {
            font-size: 28px;
            color: #f80;
            text-align: center;
            font-family: monospace;
        }

        /* ============ الإشعارات ============ */
        .toast {
            position: absolute;
            top: 90px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 30, 60, 0.98);
            border: 1px solid rgba(0, 255, 255, 0.5);
            border-radius: 10px;
            padding: 12px 25px;
            font-size: 13px;
            animation: toastIn 0.3s;
            z-index: 100;
        }

        @@keyframes toastIn {
            from { opacity: 0; transform: translateX(-50%) translateY(-20px); }
            to { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        /* ============ تأثير وضع البطء ============ */
        .slowmo-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            border: 4px solid transparent;
            pointer-events: none;
            z-index: 5;
            transition: all 0.5s;
        }

        .slowmo-overlay.active {
            border-color: rgba(255, 100, 0, 0.5);
            box-shadow: inset 0 0 100px rgba(255, 100, 0, 0.15);
        }

        /* ============ مؤشر التحديد ============ */
        .selection-ring {
            position: absolute;
            width: 80px;
            height: 80px;
            border: 3px solid #0ff;
            border-radius: 50%;
            pointer-events: none;
            display: none;
            animation: selectRing 1s infinite;
        }

        .selection-ring.active { display: block; }

        @@keyframes selectRing {
            0% { transform: translate(-50%, -50%) scale(0.5); opacity: 1; }
            100% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; }
        }
    </style>
</head>
<body>
    <!-- Canvas Container -->
    <div id="canvas-container"></div>

    <!-- Slow Motion Overlay -->
    <div class="slowmo-overlay" id="slowmoOverlay"></div>

    <!-- UI Layer -->
    <div class="ui-layer">
        <!-- شريط الأدوات -->
        <div class="top-toolbar">
            <button class="tool-btn active" id="btnSelect" title="تحديد جسيم">
                🎯
                <span class="tool-tip">تحديد (1)</span>
            </button>
            <button class="tool-btn" id="btnSlowmo" title="سرعة الضوء">
                ⚡
                <span class="tool-tip">إبطاء (2)</span>
            </button>
            <button class="tool-btn" id="btnTrack" title="تتبع">
                🔍
                <span class="tool-tip">تتبع (3)</span>
            </button>
            <button class="tool-btn" id="btnCreate" title="إنشاء عملية">
                ➕
                <span class="tool-tip">إنشاء (4)</span>
            </button>
            <button class="tool-btn" id="btnChallenge" title="تحدي">
                🏆
                <span class="tool-tip">تحدي (5)</span>
            </button>
        </div>

        <!-- لوحة المعلومات -->
        <div class="info-panel">
            <div class="panel-title">◈ إحصائيات النظام ◈</div>
            <div class="stat-row">
                <span class="stat-label">الجسيمات:</span>
                <span class="stat-value" id="statParticles">10,000</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">العمليات الحقيقية:</span>
                <span class="stat-value" id="statProcesses">0</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">سرعة الزمن:</span>
                <span class="stat-value" id="statSpeed">100%</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">الذاكرة:</span>
                <span class="stat-value" id="statMemory">-- MB</span>
            </div>
            <div class="stat-row">
                <span class="stat-label">الجسيم المحدد:</span>
                <span class="stat-value" id="statSelected">لا يوجد</span>
            </div>
        </div>

        <!-- لوحة التحكم -->
        <div class="control-panel">
            <div class="panel-title">◈ أدوات المراقب ◈</div>
            <button class="control-btn" id="ctrlCollapse">⚡ انهيار الموجة (GC)</button>
            <button class="control-btn" id="ctrlOrganize">🔧 تنظيم البيانات</button>
            <button class="control-btn" id="ctrlSuper">🌀 إنشاء تراكب</button>
            <button class="control-btn" id="ctrlMeasure">📊 قياس الحالة</button>
            <button class="control-btn danger" id="ctrlScan">🔴 فحص العمليات</button>
        </div>

        <!-- شريط سرعة الضوء -->
        <div class="lightspeed-bar">
            <div class="lightspeed-label">⚡ سرعة الضوء - التحكم بالزمن ⚡</div>
            <input type="range" class="lightspeed-slider" id="speedSlider" min="5" max="100" value="100">
            <div class="speed-labels">
                <span>🐌 5%</span>
                <span>50%</span>
                <span>100% 🚀</span>
            </div>
        </div>

        <!-- نافذة الهولوجرام -->
        <div class="hologram-window" id="holoWindow">
            <div class="holo-header">
                <span class="holo-title" id="holoTitle">◈ بيانات الجسيم ◈</span>
                <button class="holo-close" id="holoClose">✕</button>
            </div>
            <div class="holo-content" id="holoContent"></div>
            <div class="holo-actions">
                <button class="holo-btn track" id="holoTrack">🔍 تتبع</button>
                <button class="holo-btn suspend" id="holoSuspend">⏸ تعليق</button>
                <button class="holo-btn kill" id="holoKill">⛔ إنهاء</button>
            </div>
        </div>

        <!-- مؤشر التتبع -->
        <div class="tracker" id="tracker"></div>

        <!-- حلقة التحديد -->
        <div class="selection-ring" id="selectionRing"></div>

        <!-- تحدي البحث -->
        <div class="challenge-box" id="challengeBox">
            <div class="challenge-title">🏆 تحدي صائد الكم 🏆</div>
            <div class="challenge-target" id="challengeTarget">
                ابحث عن العملية المستهدفة
            </div>
            <div class="challenge-timer" id="challengeTimer">00:00</div>
            <button class="control-btn" id="btnStartChallenge" style="margin-top:10px;">🎮 بدء التحدي</button>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // ========== المتغيرات العامة ==========
        let scene, camera, renderer;
        let particles, particlePositions, particleColors;
        let raycaster, mouse;
        let timeScale = 1.0;
        let selectedIndex = -1;
        let trackingIndex = -1;
        let currentTool = 'select';
        let processData = new Map();
        let challengeActive = false;
        let challengeStart = 0;
        let challengeTargetId = -1;

        // ========== تهيئة المشهد ==========
        function init() {
            // المشهد
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x000010);
            scene.fog = new THREE.FogExp2(0x000020, 0.0008);

            // الكاميرا
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 1, 2000);
            camera.position.set(0, 100, 350);
            camera.lookAt(0, 0, 0);

            // المُصيّر
            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            // Raycaster
            raycaster = new THREE.Raycaster();
            raycaster.params.Points.threshold = 8;
            mouse = new THREE.Vector2();

            // إنشاء العناصر
            createStars();
            createRings();
            createEye();
            createParticles();

            // الأحداث
            setupEvents();

            // تحميل البيانات الحقيقية
            loadRealData();

            // بدء الرندر
            animate();
        }

        function createStars() {
            const geo = new THREE.BufferGeometry();
            const verts = [];
            for (let i = 0; i < 3000; i++) {
                verts.push(
                    (Math.random() - 0.5) * 2000,
                    (Math.random() - 0.5) * 2000,
                    (Math.random() - 0.5) * 2000
                );
            }
            geo.setAttribute('position', new THREE.Float32BufferAttribute(verts, 3));
            const mat = new THREE.PointsMaterial({ color: 0xffffff, size: 1.5 });
            scene.add(new THREE.Points(geo, mat));
        }

        function createRings() {
            const colors = [0xff4488, 0x44ff88, 0x8844ff, 0xffff44, 0x44ffff, 0xff8844, 0x88ff44];
            for (let i = 0; i < 7; i++) {
                const geo = new THREE.TorusGeometry(70 + i * 22, 1.5, 16, 100);
                const mat = new THREE.MeshBasicMaterial({ 
                    color: colors[i], 
                    transparent: true, 
                    opacity: 0.7 
                });
                const ring = new THREE.Mesh(geo, mat);
                ring.rotation.x = Math.PI / 2 + i * 0.12;
                ring.userData.ringIndex = i;
                scene.add(ring);
            }
        }

        function createEye() {
            // النواة
            const eyeGeo = new THREE.SphereGeometry(18, 32, 32);
            const eyeMat = new THREE.MeshBasicMaterial({ color: 0x0066ff, transparent: true, opacity: 0.9 });
            scene.add(new THREE.Mesh(eyeGeo, eyeMat));

            // الهالة
            const haloGeo = new THREE.RingGeometry(22, 35, 64);
            const haloMat = new THREE.MeshBasicMaterial({ color: 0x00ffff, transparent: true, opacity: 0.5, side: THREE.DoubleSide });
            scene.add(new THREE.Mesh(haloGeo, haloMat));
        }

        function createParticles() {
            const count = 10000;
            const geo = new THREE.BufferGeometry();
            particlePositions = new Float32Array(count * 3);
            particleColors = new Float32Array(count * 3);

            for (let i = 0; i < count; i++) {
                const r = 40 + Math.random() * 160;
                const theta = Math.random() * Math.PI * 2;
                const y = (Math.random() - 0.5) * 80;

                particlePositions[i * 3] = r * Math.cos(theta);
                particlePositions[i * 3 + 1] = y;
                particlePositions[i * 3 + 2] = r * Math.sin(theta);

                const color = new THREE.Color();
                color.setHSL(Math.random(), 0.9, 0.6);
                particleColors[i * 3] = color.r;
                particleColors[i * 3 + 1] = color.g;
                particleColors[i * 3 + 2] = color.b;

                // بيانات العملية
                processData.set(i, generateProcessData(i));
            }

            geo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
            geo.setAttribute('color', new THREE.BufferAttribute(particleColors, 3));

            const mat = new THREE.PointsMaterial({
                size: 4,
                vertexColors: true,
                transparent: true,
                opacity: 0.95,
                blending: THREE.AdditiveBlending,
                sizeAttenuation: true
            });

            particles = new THREE.Points(geo, mat);
            scene.add(particles);
        }

        function generateProcessData(id) {
            const names = ['chrome.exe', 'node.exe', 'explorer.exe', 'code.exe', 'dotnet.exe', 'svchost.exe', 'nginx.exe', 'python.exe'];
            return {
                id: id,
                name: names[id % names.length],
                pid: 1000 + id,
                memory: Math.floor(Math.random() * 500) + 10,
                cpu: (Math.random() * 25).toFixed(1),
                threads: Math.floor(Math.random() * 40) + 1,
                handles: Math.floor(Math.random() * 300) + 50,
                status: Math.random() > 0.1 ? 'نشط' : 'خامل',
                startTime: new Date(Date.now() - Math.random() * 86400000).toLocaleTimeString('ar')
            };
        }

        function setupEvents() {
            const canvas = renderer.domElement;

            // حركة الماوس
            canvas.addEventListener('mousemove', (e) => {
                mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
                mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
            });

            // النقر
            canvas.addEventListener('click', onCanvasClick);

            // السحب للتدوير
            let dragging = false, lastX = 0, lastY = 0;
            canvas.addEventListener('mousedown', (e) => {
                if (e.button === 2 || (e.button === 0 && e.shiftKey)) {
                    dragging = true;
                    lastX = e.clientX;
                    lastY = e.clientY;
                }
            });
            canvas.addEventListener('mousemove', (e) => {
                if (dragging) {
                    camera.position.x -= (e.clientX - lastX) * 0.5;
                    camera.position.y += (e.clientY - lastY) * 0.3;
                    camera.lookAt(0, 0, 0);
                    lastX = e.clientX;
                    lastY = e.clientY;
                }
            });
            canvas.addEventListener('mouseup', () => dragging = false);
            canvas.addEventListener('contextmenu', (e) => e.preventDefault());

            // العجلة للتكبير
            canvas.addEventListener('wheel', (e) => {
                camera.position.z = Math.max(100, Math.min(600, camera.position.z + e.deltaY * 0.5));
            });

            // أزرار الأدوات
            document.getElementById('btnSelect').onclick = () => setTool('select');
            document.getElementById('btnSlowmo').onclick = toggleSlowmo;
            document.getElementById('btnTrack').onclick = () => setTool('track');
            document.getElementById('btnCreate').onclick = createProcess;
            document.getElementById('btnChallenge').onclick = toggleChallenge;

            // أزرار التحكم
            document.getElementById('ctrlCollapse').onclick = collapseWave;
            document.getElementById('ctrlOrganize').onclick = organizeData;
            document.getElementById('ctrlSuper').onclick = createSuperposition;
            document.getElementById('ctrlMeasure').onclick = measureState;
            document.getElementById('ctrlScan').onclick = scanProcesses;

            // شريط السرعة
            document.getElementById('speedSlider').oninput = (e) => {
                timeScale = e.target.value / 100;
                document.getElementById('statSpeed').textContent = e.target.value + '%';
                document.getElementById('slowmoOverlay').classList.toggle('active', timeScale < 0.3);
            };

            // نافذة الهولوجرام
            document.getElementById('holoClose').onclick = closeHologram;
            document.getElementById('holoTrack').onclick = trackSelected;
            document.getElementById('holoSuspend').onclick = suspendSelected;
            document.getElementById('holoKill').onclick = killSelected;

            // التحدي
            document.getElementById('btnStartChallenge').onclick = startChallenge;

            // اختصارات لوحة المفاتيح
            document.addEventListener('keydown', (e) => {
                if (e.key === '1') setTool('select');
                if (e.key === '2') toggleSlowmo();
                if (e.key === '3') setTool('track');
                if (e.key === '4') createProcess();
                if (e.key === '5') toggleChallenge();
                if (e.key === 'Escape') closeHologram();
            });

            // تغيير حجم النافذة
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }

        function onCanvasClick(e) {
            raycaster.setFromCamera(mouse, camera);
            const intersects = raycaster.intersectObject(particles);

            if (intersects.length > 0) {
                const idx = intersects[0].index;
                selectParticle(idx, e.clientX, e.clientY);
            }
        }

        function selectParticle(idx, screenX, screenY) {
            selectedIndex = idx;
            document.getElementById('statSelected').textContent = '#' + idx;

            // إظهار حلقة التحديد
            const ring = document.getElementById('selectionRing');
            ring.style.left = screenX + 'px';
            ring.style.top = screenY + 'px';
            ring.classList.add('active');
            setTimeout(() => ring.classList.remove('active'), 1000);

            // إظهار الهولوجرام
            showHologram(idx, screenX, screenY);

            // التحقق من التحدي
            if (challengeActive && idx === challengeTargetId) {
                winChallenge();
            }
        }

        function showHologram(idx, x, y) {
            const data = processData.get(idx);
            if (!data) return;

            const content = document.getElementById('holoContent');
            content.innerHTML = `
                <div class="holo-row"><span class="holo-key">المعرف</span><span class="holo-value">#${data.id}</span></div>
                <div class="holo-row"><span class="holo-key">الاسم</span><span class="holo-value">${data.name}</span></div>
                <div class="holo-row"><span class="holo-key">PID</span><span class="holo-value">${data.pid}</span></div>
                <div class="holo-row"><span class="holo-key">الذاكرة</span><span class="holo-value">${data.memory} MB</span></div>
                <div class="holo-row"><span class="holo-key">CPU</span><span class="holo-value">${data.cpu}%</span></div>
                <div class="holo-row"><span class="holo-key">الخيوط</span><span class="holo-value">${data.threads}</span></div>
                <div class="holo-row"><span class="holo-key">المقابض</span><span class="holo-value">${data.handles}</span></div>
                <div class="holo-row"><span class="holo-key">الحالة</span><span class="holo-value">${data.status}</span></div>
                <div class="holo-row"><span class="holo-key">وقت البدء</span><span class="holo-value">${data.startTime}</span></div>
            `;

            document.getElementById('holoTitle').textContent = `◈ ${data.name} ◈`;

            const win = document.getElementById('holoWindow');
            win.style.left = Math.min(x + 30, window.innerWidth - 400) + 'px';
            win.style.top = Math.min(y - 50, window.innerHeight - 450) + 'px';
            win.classList.add('visible');
            win.dataset.idx = idx;
        }

        function closeHologram() {
            document.getElementById('holoWindow').classList.remove('visible');
        }

        function setTool(tool) {
            currentTool = tool;
            document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('active'));
            if (tool === 'select') document.getElementById('btnSelect').classList.add('active');
            if (tool === 'track') document.getElementById('btnTrack').classList.add('active');
        }

        function toggleSlowmo() {
            const btn = document.getElementById('btnSlowmo');
            const isActive = btn.classList.toggle('slowmo-active');
            
            if (isActive) {
                timeScale = 0.1;
                document.getElementById('speedSlider').value = 10;
                document.getElementById('statSpeed').textContent = '10%';
                document.getElementById('slowmoOverlay').classList.add('active');
                toast('⚡ وضع سرعة الضوء - الزمن يتباطأ...', '#f80');
            } else {
                timeScale = 1;
                document.getElementById('speedSlider').value = 100;
                document.getElementById('statSpeed').textContent = '100%';
                document.getElementById('slowmoOverlay').classList.remove('active');
            }
        }

        function trackSelected() {
            const idx = parseInt(document.getElementById('holoWindow').dataset.idx);
            trackingIndex = idx;
            document.getElementById('tracker').classList.add('active');
            closeHologram();
            toast('🔍 جاري تتبع الجسيم #' + idx, '#0af');
        }

        function suspendSelected() {
            const idx = document.getElementById('holoWindow').dataset.idx;
            toast('⏸ تم تعليق العملية #' + idx, '#fa0');
            closeHologram();
        }

        function killSelected() {
            const idx = document.getElementById('holoWindow').dataset.idx;
            toast('⛔ تم إنهاء العملية #' + idx, '#f44');
            closeHologram();
        }

        async function createProcess() {
            toast('➕ إنشاء عملية جديدة...', '#0af');
            try {
                const res = await fetch('/api/QuantumTools/entangle', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: '{}' });
                const data = await res.json();
                toast('✓ تم إنشاء عملية PID: ' + (data.delta?.child_pid || '?'), '#0fa');
            } catch (e) {
                toast('✗ خطأ في الإنشاء', '#f44');
            }
        }

        async function collapseWave() {
            toast('⚡ انهيار دالة الموجة...', '#f80');
            try {
                const res = await fetch('/api/QuantumTools/collapse?generation=2', { method: 'POST' });
                const data = await res.json();
                const freed = data.delta?.memory_freed_bytes || 0;
                toast('✓ تم تحرير ' + formatBytes(freed), '#0fa');
            } catch (e) {
                toast('✗ خطأ', '#f44');
            }
        }

        async function organizeData() {
            toast('🔧 تنظيم البيانات...', '#0af');
            try {
                await fetch('/api/QuantumTools/organize', { method: 'POST' });
                toast('✓ تم التنظيم', '#0fa');
            } catch (e) {}
        }

        async function createSuperposition() {
            toast('🌀 إنشاء تراكب كمي...', '#0af');
            try {
                const res = await fetch('/api/QuantumTools/superposition', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({stateCount: 10, stateSize: 1048576}) });
                const data = await res.json();
                toast('✓ تم إنشاء ' + (data.delta?.states_created || 0) + ' حالة', '#0fa');
            } catch (e) {}
        }

        async function measureState() {
            try {
                const res = await fetch('/api/QuantumTools/measure');
                const data = await res.json();
                if (data.after) {
                    document.getElementById('statMemory').textContent = formatBytes(data.after.heapSize || 0);
                }
                toast('📊 تم قياس الحالة', '#0fa');
            } catch (e) {}
        }

        async function scanProcesses() {
            toast('🔴 فحص العمليات...', '#f80');
            try {
                const res = await fetch('/api/QuantumTools/scan', { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({memoryThresholdMB: 2000}) });
                const data = await res.json();
                toast('تم فحص ' + (data.delta?.processes_scanned || 0) + ' عملية', '#0af');
            } catch (e) {}
        }

        function toggleChallenge() {
            document.getElementById('challengeBox').classList.toggle('active');
        }

        function startChallenge() {
            challengeActive = true;
            challengeStart = Date.now();
            challengeTargetId = Math.floor(Math.random() * 10000);
            
            const data = processData.get(challengeTargetId);
            document.getElementById('challengeTarget').innerHTML = `
                <div style="color:#fa0;margin-bottom:8px;">🎯 ابحث عن:</div>
                <div><b>الاسم:</b> ${data.name}</div>
                <div><b>PID:</b> ${data.pid}</div>
                <div><b>الذاكرة:</b> ${data.memory} MB</div>
            `;
            
            toast('🏆 بدأ التحدي! ابحث عن العملية', '#fa0');
            updateChallengeTimer();
        }

        function updateChallengeTimer() {
            if (!challengeActive) return;
            const elapsed = Math.floor((Date.now() - challengeStart) / 1000);
            const m = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const s = (elapsed % 60).toString().padStart(2, '0');
            document.getElementById('challengeTimer').textContent = m + ':' + s;
            requestAnimationFrame(updateChallengeTimer);
        }

        function winChallenge() {
            challengeActive = false;
            const elapsed = ((Date.now() - challengeStart) / 1000).toFixed(1);
            toast('🎉 فزت! الوقت: ' + elapsed + ' ثانية', '#0fa');
            document.getElementById('challengeBox').classList.remove('active');
        }

        function loadRealData() {
            // محاولة الاتصال بالخادم
            try {
                const es = new EventSource('/api/Monitoring/events');
                es.onmessage = (e) => {
                    const data = JSON.parse(e.data);
                    // تحديث بيانات العمليات الحقيقية
                    if (data.processId) {
                        const idx = data.processId % 10000;
                        processData.set(idx, {
                            ...processData.get(idx),
                            name: data.data?.name || processData.get(idx)?.name,
                            memory: Math.floor((data.data?.working_set || 0) / 1048576),
                            threads: data.data?.threads || 0,
                            status: 'حقيقي'
                        });
                    }
                };
            } catch (e) {}

            // تحديث دوري
            setInterval(async () => {
                try {
                    const res = await fetch('/api/QuantumTools/measure');
                    const data = await res.json();
                    if (data.after) {
                        document.getElementById('statMemory').textContent = formatBytes(data.after.heapSize || 0);
                        document.getElementById('statProcesses').textContent = data.after.processCount || 0;
                    }
                } catch (e) {}
            }, 3000);
        }

        function toast(msg, color = '#0cf') {
            const t = document.createElement('div');
            t.className = 'toast';
            t.style.color = color;
            t.style.borderColor = color;
            t.textContent = msg;
            document.querySelector('.ui-layer').appendChild(t);
            setTimeout(() => t.remove(), 3000);
        }

        function formatBytes(b) {
            if (!b) return '0 B';
            const k = 1024;
            const s = ['B', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(Math.abs(b)) / Math.log(k));
            return (b / Math.pow(k, i)).toFixed(1) + ' ' + s[i];
        }

        // ========== حلقة الرندر ==========
        function animate() {
            requestAnimationFrame(animate);

            const time = Date.now() * 0.001 * timeScale;

            // تدوير الجسيمات
            if (particles) {
                particles.rotation.y += 0.002 * timeScale;

                // تحريك الجسيمات
                for (let i = 0; i < particlePositions.length; i += 3) {
                    const idx = i / 3;
                    particlePositions[i + 1] += Math.sin(time + idx * 0.01) * 0.03 * timeScale;
                }
                particles.geometry.attributes.position.needsUpdate = true;
            }

            // تدوير الحلقات
            scene.traverse((obj) => {
                if (obj.userData.ringIndex !== undefined) {
                    obj.rotation.y += 0.003 * timeScale * (obj.userData.ringIndex + 1) * 0.3;
                }
            });

            // تحديث مؤشر التتبع
            if (trackingIndex >= 0) {
                const pos = new THREE.Vector3(
                    particlePositions[trackingIndex * 3],
                    particlePositions[trackingIndex * 3 + 1],
                    particlePositions[trackingIndex * 3 + 2]
                );
                pos.applyMatrix4(particles.matrixWorld);
                pos.project(camera);
                
                const x = (pos.x + 1) / 2 * window.innerWidth;
                const y = (-pos.y + 1) / 2 * window.innerHeight;
                
                const tracker = document.getElementById('tracker');
                tracker.style.left = (x - 30) + 'px';
                tracker.style.top = (y - 30) + 'px';
            }

            renderer.render(scene, camera);
        }

        // ========== البدء ==========
        init();
    </script>
</body>
</html>
