@{
    ViewData["Title"] = "Neural Spine Visualization - تصور النخاع الشوكي الرقمي";
}

<style>
    body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: linear-gradient(135deg, #0a0a15 0%, #1a1a2e 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .neural-container {
        position: relative;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
    }

    #neuralSpineCanvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .hud-overlay {
        position: absolute;
        top: 20px;
        right: 20px;
        background: rgba(10, 10, 30, 0.85);
        border: 1px solid rgba(100, 150, 255, 0.3);
        border-radius: 10px;
        padding: 20px;
        color: #fff;
        font-family: 'Courier New', monospace;
        min-width: 300px;
        backdrop-filter: blur(10px);
        box-shadow: 0 0 30px rgba(100, 150, 255, 0.2);
        direction: rtl;
    }

    .hud-title {
        font-size: 18px;
        font-weight: bold;
        color: #64b5f6;
        margin-bottom: 15px;
        text-align: center;
        text-shadow: 0 0 10px rgba(100, 181, 246, 0.5);
    }

    .stat-row {
        display: flex;
        justify-content: space-between;
        margin: 8px 0;
        padding: 5px;
        border-bottom: 1px solid rgba(100, 150, 255, 0.1);
    }

    .stat-label {
        color: #90caf9;
        font-size: 13px;
    }

    .stat-value {
        color: #fff;
        font-weight: bold;
        font-size: 14px;
    }

    .stat-value.active {
        color: #4caf50;
        text-shadow: 0 0 5px rgba(76, 175, 80, 0.5);
    }

    .stat-value.peak {
        color: #ff9800;
        text-shadow: 0 0 5px rgba(255, 152, 0, 0.5);
    }

    .legend {
        position: absolute;
        bottom: 20px;
        left: 20px;
        background: rgba(10, 10, 30, 0.85);
        border: 1px solid rgba(100, 150, 255, 0.3);
        border-radius: 10px;
        padding: 15px;
        color: #fff;
        backdrop-filter: blur(10px);
        direction: rtl;
    }

    .legend-title {
        font-weight: bold;
        color: #64b5f6;
        margin-bottom: 10px;
        font-size: 14px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        margin: 5px 0;
        font-size: 12px;
    }

    .legend-color {
        width: 20px;
        height: 3px;
        margin-left: 10px;
        border-radius: 2px;
        box-shadow: 0 0 10px currentColor;
    }

    .controls {
        position: absolute;
        top: 20px;
        left: 20px;
        background: rgba(10, 10, 30, 0.85);
        border: 1px solid rgba(100, 150, 255, 0.3);
        border-radius: 10px;
        padding: 15px;
        color: #fff;
        backdrop-filter: blur(10px);
        direction: rtl;
    }

    .control-button {
        background: rgba(100, 150, 255, 0.2);
        border: 1px solid rgba(100, 150, 255, 0.5);
        color: #64b5f6;
        padding: 8px 16px;
        margin: 5px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 12px;
        transition: all 0.3s;
    }

    .control-button:hover {
        background: rgba(100, 150, 255, 0.4);
        box-shadow: 0 0 15px rgba(100, 150, 255, 0.3);
    }

    .control-button.active {
        background: rgba(76, 175, 80, 0.3);
        border-color: #4caf50;
        color: #4caf50;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(10, 10, 30, 0.95);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #64b5f6;
        font-size: 24px;
        z-index: 1000;
        transition: opacity 0.5s;
    }

    .loading-overlay.hidden {
        opacity: 0;
        pointer-events: none;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 3px solid rgba(100, 150, 255, 0.3);
        border-top: 3px solid #64b5f6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .warning-message {
        position: absolute;
        bottom: 20px;
        right: 20px;
        background: rgba(255, 152, 0, 0.15);
        border: 1px solid rgba(255, 152, 0, 0.5);
        border-radius: 8px;
        padding: 12px 20px;
        color: #ff9800;
        font-size: 13px;
        max-width: 300px;
        direction: rtl;
        display: none;
    }

    .warning-message.show {
        display: block;
        animation: fadeIn 0.3s;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="neural-container">
    <div id="neuralSpineCanvas"></div>

    <div class="loading-overlay" id="loadingOverlay">
        <div class="spinner"></div>
        <div>تهيئة النخاع الرقمي...</div>
    </div>

    <div class="hud-overlay">
        <div class="hud-title">◈ لوحة المعلومات الحية ◈</div>
        <div class="stat-row">
            <span class="stat-label">إجمالي الأحداث:</span>
            <span class="stat-value" id="totalEvents">0</span>
        </div>
        <div class="stat-row">
            <span class="stat-label">الأعصاب النشطة:</span>
            <span class="stat-value active" id="activeNerves">0</span>
        </div>
        <div class="stat-row">
            <span class="stat-label">معدل الذروة (حدث/ث):</span>
            <span class="stat-value peak" id="peakRate">0</span>
        </div>
        <div class="stat-row">
            <span class="stat-label">حجم الطابور:</span>
            <span class="stat-value" id="queueSize">0</span>
        </div>
        <div class="stat-row">
            <span class="stat-label">وقت التشغيل:</span>
            <span class="stat-value" id="uptime">00:00:00</span>
        </div>
    </div>

    <div class="controls">
        <button class="control-button active" id="toggleStream">إيقاف البث</button>
        <button class="control-button" id="toggleRotation">إيقاف الدوران</button>
        <button class="control-button" id="resetView">إعادة ضبط العرض</button>
    </div>

    <div class="legend">
        <div class="legend-title">◈ دليل البروتوكولات ◈</div>
        <div class="legend-item">
            <span>TCP (حزم البيانات)</span>
            <div class="legend-color" style="background: rgb(100, 255, 100);"></div>
        </div>
        <div class="legend-item">
            <span>UDP (البث السريع)</span>
            <div class="legend-color" style="background: rgb(255, 200, 100);"></div>
        </div>
        <div class="legend-item">
            <span>أخرى (نشاط عام)</span>
            <div class="legend-color" style="background: rgb(200, 100, 255);"></div>
        </div>
    </div>

    <div class="warning-message" id="warningMessage">
        ⚠️ معدل البيانات مرتفع جداً. قد يحدث بطء في العرض.
    </div>
</div>

<script src="~/js/neural-spine-viz.js"></script>
<script>
    let neuralViz;
    let eventSource;
    let isStreamActive = true;
    let isRotating = true;
    let startTime = Date.now();

    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            document.getElementById('loadingOverlay').classList.add('hidden');
        }, 2000);

        neuralViz = new NeuralSpineVisualization('neuralSpineCanvas', {
            spineSegments: 60,
            nervesPerSegment: 12,
            pulseSpeed: 2.5,
            glowIntensity: 2.0,
            rotationSpeed: 0.15
        });

        connectToEventStream();
        setupControls();
        startStatsUpdate();
    });

    function connectToEventStream() {
        eventSource = new EventSource('/api/monitoring/events');

        eventSource.onmessage = (event) => {
            if (!isStreamActive) return;

            try {
                const data = JSON.parse(event.data);
                
                // تحويل البيانات من KernelEvent إلى التنسيق المتوقع
                const vizData = {
                    protocol: data.data?.protocol || 6,
                    bytes: data.data?.bytes || 1000,
                    timestamp: new Date(data.timestamp).getTime(),
                    src_ip: data.data?.src_ip || '0.0.0.0',
                    dst_ip: data.data?.dst_ip || '0.0.0.0'
                };
                
                neuralViz.processEbpfData(vizData);
            } catch (e) {
                console.error('Error parsing event data:', e);
            }
        };

        eventSource.onerror = (error) => {
            console.error('EventSource error:', error);
            eventSource.close();
            setTimeout(connectToEventStream, 5000);
        };
    }

    function setupControls() {
        document.getElementById('toggleStream').addEventListener('click', (e) => {
            isStreamActive = !isStreamActive;
            e.target.textContent = isStreamActive ? 'إيقاف البث' : 'تشغيل البث';
            e.target.classList.toggle('active');
        });

        document.getElementById('toggleRotation').addEventListener('click', (e) => {
            isRotating = !isRotating;
            neuralViz.options.rotationSpeed = isRotating ? 0.15 : 0;
            e.target.textContent = isRotating ? 'إيقاف الدوران' : 'تشغيل الدوران';
            e.target.classList.toggle('active');
        });

        document.getElementById('resetView').addEventListener('click', () => {
            neuralViz.scene.camera.position = [0, 0, 15];
            neuralViz.scene.camera.rotation = [0, 0, 0];
            neuralViz.scene.rotation = 0;
        });
    }

    function startStatsUpdate() {
        setInterval(() => {
            const stats = neuralViz.getStats();
            
            document.getElementById('totalEvents').textContent = stats.total.toLocaleString();
            document.getElementById('activeNerves').textContent = stats.activeNerves;
            document.getElementById('peakRate').textContent = Math.floor(stats.peakRate);
            document.getElementById('queueSize').textContent = stats.queueSize;

            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            const hours = Math.floor(elapsed / 3600).toString().padStart(2, '0');
            const minutes = Math.floor((elapsed % 3600) / 60).toString().padStart(2, '0');
            const seconds = (elapsed % 60).toString().padStart(2, '0');
            document.getElementById('uptime').textContent = `${hours}:${minutes}:${seconds}`;

            const warning = document.getElementById('warningMessage');
            if (stats.peakRate > 100) {
                warning.classList.add('show');
            } else {
                warning.classList.remove('show');
            }
        }, 100);
    }

    window.addEventListener('beforeunload', () => {
        if (eventSource) eventSource.close();
        if (neuralViz) neuralViz.destroy();
    });
</script>
